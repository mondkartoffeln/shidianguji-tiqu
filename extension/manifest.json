{
  "manifest_version": 3,
  "name": "识典古籍取图",
  "version": "1.1.1",
  "description": "一键保存识典古籍阅读器里的整页原图（不是屏幕截图），可批量采集整章。",
  "minimum_chrome_version": "111",
  "permissions": ["webRequest", "downloads", "storage", "offscreen"],
  "host_permissions": [
    "*://*.shidianguji.com/*",
    "*://*.byteimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.shidianguji.com/*"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.shidianguji.com/*"],
      "js": ["t2s-table.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "识典古籍取图",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
